# =============================================================================
# JobOS — environment
# Copy to .env.local and fill in. .env* is gitignored; never commit real keys.
# =============================================================================

# ── Database (Phase 1) ───────────────────────────────────────────────────────
# Neon → your project → Connection Details → pooled connection string.
# The pooled host (…-pooler.…) is the right one for serverless.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Phase 1) ───────────────────────────────────────────────────────────
# Neon Auth. Enable Auth in the Neon console; it provisions the
# neon_auth.users_sync table in the same database and hands you these keys.
# Nothing in Phase 0 reads them.
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# ── Models (Phase 3) ─────────────────────────────────────────────────────────
# Gemini is primary (free tier); Groq is the fallback when Gemini rate-limits.
# https://aistudio.google.com/apikey  ·  https://console.groq.com/keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ── Job discovery (Phase 4) ──────────────────────────────────────────────────
# Adzuna developer tier: https://developer.adzuna.com/
# Greenhouse and Lever need no credentials — they publish per-company JSON
# feeds — but they do need a watchlist of company tokens, set in the app.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
