# =============================================================================
# JobOS — environment
#
# Copy to .env.local and fill in. `.env*` is gitignored except this file;
# never commit real values. See docs/DATABASE.md for where each one comes from.
#
# Everything below can be produced from the Neon CLI — see the README.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# neonctl connection-string production --project-id <id> --pooled
# The pooled host (…-pooler.…) is what the app uses at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The direct host, used only by drizzle-kit. PgBouncer does not reliably carry
# the session state that DDL and advisory locks need.
# neonctl connection-string production --project-id <id>
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Neon Auth is Better Auth hosted by Neon, writing into the `neon_auth` schema
# of the same database. Enable it with:
#   neonctl neon-auth enable --project-id <id> --branch <branch>
# which prints the base_url below.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"

# Signs the session cookie on your origin. Minimum 32 characters — the SDK
# throws below that. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=""

# ── Demo account (optional) ──────────────────────────────────────────────────
# Powers the "Explore the demo account" button and `pnpm db:seed`. Leave these
# unset and the button reports that no demo is configured, which is the right
# behaviour for a private deployment.
DEMO_EMAIL="demo@jobos.app"
DEMO_PASSWORD=""
DEMO_NAME="Demo User"

# Origin used when seeding against a deployed environment. Defaults to
# http://localhost:3000, which Neon Auth trusts because `allow_localhost` is on.
# APP_ORIGIN="https://job.imswarnil.com"

# ── Models ───────────────────────────────────────────────────────────────────
# Three providers, tried in order until one answers. Any failure on the first
# — rate limit, outage, unusable answer — falls through to the next.
# https://aistudio.google.com/apikey  ·  https://console.groq.com/keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Model names are pinned in code but overridable here, because providers retire
# them: both original defaults had already been withdrawn by the time they were
# first called. Leave unset unless something 404s.
#
# List what is currently available:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models
# GEMINI_MODEL="gemini-3.6-flash"
# GROQ_MODEL="openai/gpt-oss-120b"

# ── Self-hosted model (optional) ─────────────────────────────────────────────
# An Ollama instance. Must be reachable *from wherever JobOS runs* — on Vercel
# that means publicly reachable and authenticated. A localhost URL works in
# development and silently fails in production.
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2:3b"
# OLLAMA_API_KEY=""              # only if it sits behind a reverse proxy

# Which providers to try, in order. Default: gemini,groq,ollama.
# Put ollama first when you host something large yourself — then the hosted
# free tiers become the fallback rather than the default.
# LLM_PROVIDER_ORDER="ollama,gemini,groq"

# Model requests per user per rolling 24 hours. 0 = unmetered, which is the
# right setting when inference is self-hosted and costs you nothing per call.
# LLM_RATE_LIMIT="5"

# Self-hosted inference, over Ollama. Unset by default: JobOS talks to the
# hosted providers unless you give it somewhere else to go.
#
# The URL must be reachable *from wherever JobOS runs*. Vercel is not on your
# network, so a localhost URL works in development and silently fails in
# production — a public hostname behind TLS with a bearer token is the only
# arrangement that serves both.
# OLLAMA_BASE_URL="https://ollama.example.com"
# OLLAMA_API_KEY=""
# OLLAMA_MODEL="llama3.2:3b"

# Which providers to try, and in what order. Defaults to gemini,groq,ollama —
# hosted first, which is right while you are living on free tiers. Put ollama
# first once you own hardware that can beat them and quota stops mattering.
# Names not in the list are never called, so this doubles as an off switch.
# LLM_PROVIDER_ORDER="gemini,groq,ollama"

# Model requests per person per rolling 24 hours. Defaults to 5. The cap is
# there because the hosted providers bill someone; set it to 0 to disable
# metering entirely, which only makes sense once ollama is serving the
# requests. Leave it commented rather than empty — an empty value is treated
# as unset, not as 0, so that a stray "" cannot quietly remove the limit.
# LLM_RATE_LIMIT="5"

# ── Job discovery (Phase 4) ──────────────────────────────────────────────────
# Adzuna developer tier: https://developer.adzuna.com/
# Greenhouse and Lever need no credentials — they publish per-company JSON
# feeds — but they do need a watchlist of company tokens, set in the app.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
