# =============================================================================
# JobOS — environment
#
# Copy to .env.local and fill in. `.env*` is gitignored except this file;
# never commit real values. See docs/DATABASE.md for where each one comes from.
#
# Everything below can be produced from the Neon CLI — see the README.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# neonctl connection-string production --project-id <id> --pooled
# The pooled host (…-pooler.…) is what the app uses at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The direct host, used only by drizzle-kit. PgBouncer does not reliably carry
# the session state that DDL and advisory locks need.
# neonctl connection-string production --project-id <id>
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Neon Auth is Better Auth hosted by Neon, writing into the `neon_auth` schema
# of the same database. Enable it with:
#   neonctl neon-auth enable --project-id <id> --branch <branch>
# which prints the base_url below.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"

# Signs the session cookie on your origin. Minimum 32 characters — the SDK
# throws below that. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=""

# ── Demo account (optional) ──────────────────────────────────────────────────
# Powers the "Explore the demo account" button and `pnpm db:seed`. Leave these
# unset and the button reports that no demo is configured, which is the right
# behaviour for a private deployment.
DEMO_EMAIL="demo@jobos.app"
DEMO_PASSWORD=""
DEMO_NAME="Demo User"

# Origin used when seeding against a deployed environment. Defaults to
# http://localhost:3000, which Neon Auth trusts because `allow_localhost` is on.
# APP_ORIGIN="https://job.imswarnil.com"

# ── Models ───────────────────────────────────────────────────────────────────
# Gemini is primary (free tier); Groq is the fallback. Any failure on the first
# — rate limit, outage, unusable answer — falls through to the second.
# https://aistudio.google.com/apikey  ·  https://console.groq.com/keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Model names are pinned in code but overridable here, because providers retire
# them: both original defaults had already been withdrawn by the time they were
# first called. Leave unset unless something 404s.
#
# List what is currently available:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models
# GEMINI_MODEL="gemini-3.6-flash"
# GROQ_MODEL="openai/gpt-oss-120b"

# ── Job discovery (Phase 4) ──────────────────────────────────────────────────
# Adzuna developer tier: https://developer.adzuna.com/
# Greenhouse and Lever need no credentials — they publish per-company JSON
# feeds — but they do need a watchlist of company tokens, set in the app.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
