# =============================================================================
# JobOS — environment
#
# Copy to .env.local and fill in. `.env*` is gitignored except this file;
# never commit real values. See docs/DATABASE.md for where each one comes from.
#
# Everything below can be produced from the Neon CLI — see the README.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# neonctl connection-string production --project-id <id> --pooled
# The pooled host (…-pooler.…) is what the app uses at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The direct host, used only by drizzle-kit. PgBouncer does not reliably carry
# the session state that DDL and advisory locks need.
# neonctl connection-string production --project-id <id>
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Neon Auth is Better Auth hosted by Neon, writing into the `neon_auth` schema
# of the same database. Enable it with:
#   neonctl neon-auth enable --project-id <id> --branch <branch>
# which prints the base_url below.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"

# Signs the session cookie on your origin. Minimum 32 characters — the SDK
# throws below that. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=""

# ── Demo account (optional) ──────────────────────────────────────────────────
# Powers the "Explore the demo account" button and `pnpm db:seed`. Leave these
# unset and the button reports that no demo is configured, which is the right
# behaviour for a private deployment.
DEMO_EMAIL="demo@jobos.app"
DEMO_PASSWORD=""
DEMO_NAME="Demo User"

# Origin used when seeding against a deployed environment. Defaults to
# http://localhost:3000, which Neon Auth trusts because `allow_localhost` is on.
# APP_ORIGIN="https://job.imswarnil.com"

# ── Models ───────────────────────────────────────────────────────────────────
# Three providers, tried in order until one answers. Any failure on the first —
# unreachable, rate limited, outage, unusable answer — falls through to the
# next, so a switched-off laptop costs one refused connection and nothing else.
#
# The default order is SELF-HOSTED FIRST:
#
#   ollama  →  gemini  →  groq
#   └ yours ┘  └─ hosted fallback ─┘
#
# What travels through this seam is a whole work history plus every role you
# are quietly considering. Self-hosted inference keeps that on hardware you
# own and costs nothing per call; the hosted keys are the safety net for when
# the box is asleep or unreachable, not the default path.

# ── Ollama (preferred) ───────────────────────────────────────────────────────
# The box you own. First in the chain, and the reason is not quality: what
# goes through here is a whole work history plus every role you are quietly
# considering, and inference you host has no per-request cost, no quota, and
# no third party reading it.
#
# Must resolve from *wherever JobOS runs*. With JobOS on the VPS beside it
# that is localhost; on Vercel it has to be a public HTTPS hostname with a
# bearer token in front, because Ollama has no authentication of its own and
# an exposed :11434 is a free GPU for the internet.
#
#   list what is installed:  curl -s $OLLAMA_BASE_URL/api/tags
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Optional bearer, for an instance behind a reverse proxy. Required in
# practice if the instance is exposed to the internet at all.
# OLLAMA_API_KEY=

# ── Hosted (last resort) ─────────────────────────────────────────────────────
# https://aistudio.google.com/apikey  ·  https://console.groq.com/keys
# Leave both unset to guarantee nothing ever leaves your hardware — the
# feature then reports an honest failure instead of quietly calling out.
GEMINI_API_KEY=
GROQ_API_KEY=

# Model names are pinned in code but overridable here, because providers retire
# them: both original defaults had already been withdrawn by the time they were
# first called. Leave unset unless something 404s.
#
# List what is currently available:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models
# GEMINI_MODEL=
# GROQ_MODEL=

# Which providers to try, in order.
# Default: ollama,gemini,groq
# Set it to just "ollama" and no request can ever leave the box.
# LLM_PROVIDER_ORDER=

# How long to wait for one provider, in ms. Default 120000.
#
# The old 25s suited hosted APIs and strangles CPU inference: a review that
# takes 5s on a laptop takes ~54s on a GPU-less VPS, and the short ceiling
# hung up on the local model every time and silently used Gemini instead.
# Raise it only if your host lets a request run that long — on Vercel the
# function's max duration wins regardless.
# LLM_TIMEOUT_MS=

# Model requests per user per rolling 24 hours.
#
# Leave it unset and JobOS decides: 5 while a hosted key is in the chain, and
# unmetered when every provider that would actually be called is self-hosted —
# because the cap exists to protect a shared paid key, and there is then no
# such key to protect. Set a number here only to override that judgement.
#
# Leave it commented rather than empty. An empty value reads as unset, not as
# 0, so a stray "" cannot quietly change the policy.
# LLM_RATE_LIMIT=

# ── Fetching one posting from a URL (optional) ───────────────────────────────
# A Crawl4AI instance, used when you paste a job link. Plain fetch gets the
# HTML; many boards render the description in the browser, so plain HTML is an
# empty shell and Crawl4AI runs a real one. Unset means plain fetch only.
#
# Same rule as Ollama: must resolve from wherever JobOS runs. It must also be
# reachable over the public internet if JobOS is on Vercel, which means it
# needs the API key set — an open /crawl endpoint is a fetch-any-URL service
# with your server's name on it.
# CRAWL4AI_BASE_URL="https://crawl.example.com"
# CRAWL4AI_API_KEY=""


# ── Title search (Google Programmable Search) ────────────────────────────────
# Answers "who is hiring a Salesforce Developer this week" — the question
# Greenhouse and Lever cannot, because a board token IS their query.
#
# This is the documented JSON API, not a SERP scraper. Automating
# google.com/search is against Google's terms and the block lands on an IP —
# on this deployment that IP also serves crawl4ai, Ollama, Ghost and n8n.
#
#   key:  https://console.cloud.google.com → enable "Custom Search API"
#   cx:   https://programmablesearchengine.google.com → create an engine,
#         switch OFF "Search the entire web", and add the ATS sites:
#           job-boards.greenhouse.io/*   boards.greenhouse.io/*
#           jobs.lever.co/*              jobs.ashbyhq.com/*
#           *.myworkdayjobs.com/*
#         Without that restriction you get articles about the job market
#         instead of jobs.
#
# 100 queries/day free, which is far more than a 3-hourly schedule over a
# handful of titles needs.
GOOGLE_SEARCH_KEY=
GOOGLE_SEARCH_CX=

# ── Job discovery (Phase 4) ──────────────────────────────────────────────────
# Adzuna developer tier: https://developer.adzuna.com/
# Greenhouse and Lever need no credentials — they publish per-company JSON
# feeds — but they do need a watchlist of company tokens, set in the app.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ── The discovery runner (Phase 4) ───────────────────────────────────────────
# The n8n workflow in docs/n8n/ runs the watchlist on a schedule and posts what
# it finds to /api/ingest/*. Those two endpoints are the only writes in JobOS
# that do not come from a session, which is why they are gated on a secret
# rather than a cookie. See docs/DISCOVERY-PIPELINE.md.
#
# Leave both unset and ingest is disabled — the endpoints answer 500 rather
# than falling open. Generate the token with:
#
#   openssl rand -hex 32
#
# INGEST_TOKEN must be at least 32 characters or it is refused.
INGEST_TOKEN=""
# The account the runner writes into. Never read from the request body, so a
# leaked token can only write into this one account, not choose another.
#   select id, email from neon_auth."user";
INGEST_OWNER_ID=""
